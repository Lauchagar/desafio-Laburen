    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE products\nSET cantidad_disponible = cantidad_disponible - {{ $json.delta_qty }}\nWHERE id = {{ $json.product_id }}\n  AND (cantidad_disponible >= {{ $json.delta_qty }} OR {{ $json.delta_qty }} < 0)\nRETURNING id;",
