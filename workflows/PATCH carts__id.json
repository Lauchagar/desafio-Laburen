        "jsCode": "const queryResult = $json;\nconst inputQty = $('Split Items').item.json.qty;\nconst productId = $('Split Items').item.json.product_id;\nconst currentQty = queryResult.qty || 0; \n\nif (currentQty == 0) {\n    throw new Error('Producto ID ' + productId + ' no encontrado en el carrito.');\n}\nconst finalQty = currentQty + inputQty;\n\nreturn {\n    product_id: productId,\n    delta_qty: inputQty,\n    current_qty: currentQty,\n    final_qty: finalQty\n};"
      },
