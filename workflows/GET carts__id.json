            {
              "id": "d5eed868-35b2-4c8c-a33a-53ea78ec95a7",
              "name": "query",
              "value": "=SELECT \n    ci.cart_id,\n    ci.product_id,\n    ci.qty,\n    CONCAT(p.tipo_prenda, ' ', p.color, ' ', p.talla) as nombre_producto,\n    p.categoria,\n    p.tipo_prenda,\n    p.descripcion,\n    p.precio_50_u as precio_50_unitario\nFROM cart_items ci\nJOIN carts c ON ci.cart_id = c.id\nJOIN products p ON ci.product_id = p.id\nWHERE c.user_id = ($1) \n  AND c.estado = 'activo';",
              "type": "string"
            }
          ]
        },
