    {
      "parameters": {
        "jsCode": "const nombreQuery = $input.first().json.query.nombre;\nconst categoriaQuery = $input.first().json.query.categoria;\nconst descripcionQuery = $input.first().json.query.descripcion; \n\nlet where = [];\nlet params = [];\nlet paramIndex = 1;\n\n// Filtro de Nombre\nif (nombreQuery) {\n    where.push(`unaccent(tipo_prenda) ILIKE unaccent($${paramIndex})`);\n    params.push(`%${nombreQuery}%`);\n    paramIndex++;\n}\n\n// Filtro de Descripcion\nif (descripcionQuery) {\n    where.push(`unaccent(descripcion) ILIKE unaccent($${paramIndex})`);\n    params.push(`%${descripcionQuery}%`);\n    paramIndex++;\n}\n\n// Filtro de Categoria\nif (categoriaQuery) {\n    where.push(`unaccent(categoria) ILIKE unaccent($${paramIndex})`);\n    params.push(`%${categoriaQuery}%`);\n    paramIndex++;\n}\n\n// Consulta SQL final\nlet sql = 'SELECT * FROM products'; \n\nif (where.length > 0) {\n    // Si hay mas de un filtro, se unen con  AND \n    sql += ' WHERE ' + where.join(' AND ');\n}\n\nreturn { \n    query: sql, \n    params: params \n};"
      },
