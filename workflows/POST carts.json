    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH existing_cart AS (\n    SELECT id FROM carts WHERE user_id = '{{ $('items').item.json.user_id }}' AND estado = 'activo'\n), \ninserted_cart AS (\n    INSERT INTO carts (user_id) \n    SELECT '{{ $('items').item.json.user_id }}' \n    WHERE NOT EXISTS (SELECT 1 FROM existing_cart)\n    RETURNING id\n)\n\nSELECT id FROM existing_cart\nUNION ALL\nSELECT id FROM inserted_cart;",
        "options": {}
      },
